---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config";

const pipeline = [
  "Discover",
  "Rank",
  "Analyse",
  "Tailor",
  "Human review",
  "Assisted apply",
  "Follow up",
  "Learn",
];

const platformSupport = [
  { name: "Greenhouse", status: "Form filling, live-validated" },
  { name: "Lever", status: "Form filling, live-validated" },
  { name: "Ashby", status: "Form filling" },
  { name: "SmartRecruiters", status: "Form filling (experimental)" },
  { name: "Jobvite", status: "Form filling (experimental)" },
  { name: "Workday", status: "Discovery" },
  { name: "Naukri", status: "Import + assisted handoff" },
  { name: "LinkedIn", status: "Alert-email import" },
];

const safety = [
  "Applicant data stays on the local machine — no hosted database, no server, no multi-tenant store.",
  "The renderer process has no Node.js, filesystem, or credential access; a narrow typed bridge is the only path to the main process.",
  "Background workers (discovery, run execution, assisted-apply sessions, Naukri handoff) run isolated, so a crash in one doesn't take the app down.",
  "CAPTCHA and MFA are never automated or bypassed — those steps stay in the applicant's hands.",
  "Nothing clicks Submit. ATS adapters have no submit method; a separate human confirmation records that a submission happened.",
  "Browser sessions and cookies stay on the applicant's device and are discarded per-application, including on failure paths.",
];

const engineering = [
  "TypeScript",
  "Electron",
  "React",
  "SQLite + Drizzle ORM",
  "Playwright",
  "Vitest",
  "Zod-typed IPC contracts",
  "LangGraph state machine",
];

const lessons = [
  "Stale DOM selectors on real ATS forms break silently — verification has to re-read filled values after the form settles, not just trust the write.",
  "Browser profile locking on the Naukri handoff needed explicit session isolation per application, not a single shared profile.",
  "Dependable agent behavior comes from explicit boundaries (typed state transitions, deterministic policy, process isolation) more than from a better prompt.",
  "Conservative capability labeling matters: a platform with implemented form-filling but no live validation is marked experimental, not fully supported.",
];
---

<BaseLayout
  title="AI Job Agent"
  description="A local-first desktop agent that discovers, evaluates, tailors, and assists job applications — without submitting anything behind the applicant's back."
>
  <main class="bg-grid">
    <!-- 1 & 2: Problem + Product -->
    <section class="mx-auto max-w-3xl px-6 pb-14 pt-16 sm:pt-24">
      <p class="font-mono-tight text-xs text-cyan-400">Flagship project</p>
      <h1
        class="mt-3 text-3xl font-semibold tracking-tight text-paper-50 sm:text-4xl"
      >
        AI Job Agent
      </h1>
      <p class="mt-5 text-lg text-paper-300">
        Job searching is fragmented across boards, ATS platforms, email
        alerts, referrals, resumes, and follow-ups. AI Job Agent is a desktop
        application that keeps those workflows together — discovering roles,
        scoring fit, and preparing grounded application material — without
        handing account control to an uncontrolled bot.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={siteConfig.githubUrl.replace(
            "pushpendra-devera",
            "pushpendra-devera/ai-job-agent",
          )}
          class="rounded-md bg-cyan-500 px-5 py-2.5 text-sm font-medium text-graphite-950 transition-colors hover:bg-cyan-400"
        >
          View source on GitHub
        </a>
        <a
          href="/architecture"
          class="rounded-md border border-graphite-600 px-5 py-2.5 text-sm font-medium text-paper-100 transition-colors hover:border-cyan-500 hover:text-cyan-400"
        >
          Read the architecture
        </a>
      </div>
    </section>

    <!-- 3: How it works -->
    <section class="border-t border-graphite-700/80 py-14">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-paper-500">
          How it works
        </h2>
        <div class="mt-6 flex flex-wrap items-center gap-2">
          {
            pipeline.map((step, i) => (
              <>
                <span
                  class:list={[
                    "font-mono-tight rounded-md border px-3 py-1.5 text-sm",
                    step === "Human review"
                      ? "border-amber-500/60 text-amber-400"
                      : "border-graphite-600 text-paper-100",
                  ]}
                >
                  {step}
                </span>
                {i < pipeline.length - 1 && (
                  <span class="text-paper-500">→</span>
                )}
              </>
            ))
          }
        </div>
        <p class="mt-4 text-sm text-paper-500">
          Human review is a durable pause, not a formality — the run
          checkpoints to disk and won't move to assisted-apply without an
          explicit approval.
        </p>
      </div>
    </section>

    <!-- 4: Interactive demo (placeholder for phase 2) -->
    <section class="border-t border-graphite-700/80 py-14">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-paper-500">
          Interactive demo
        </h2>
        <div
          class="mt-6 rounded-lg border border-dashed border-graphite-600 p-8 text-center text-paper-400"
        >
          <p>
            A synthetic-data walkthrough — fictional job, fit score,
            tailored resume, review queue — is coming soon.
          </p>
          <p class="mt-2 text-sm text-paper-500">
            It will run entirely in the browser on fictional data and will
            never touch a real account or perform a real application.
          </p>
        </div>
      </div>
    </section>

    <!-- 5: Platform support -->
    <section class="border-t border-graphite-700/80 py-14">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-paper-500">
          Platform support
        </h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            platformSupport.map((p) => (
              <div
                class="flex items-center justify-between rounded-md border border-graphite-700 px-4 py-3"
              >
                <span class="font-mono-tight text-sm text-paper-100">
                  {p.name}
                </span>
                <span class="text-xs text-paper-500">{p.status}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 6: AI architecture -->
    <section class="border-t border-graphite-700/80 py-14">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-paper-500">
          AI architecture
        </h2>
        <p class="mt-6 text-paper-300">
          Model calls go through an application-owned provider abstraction
          rather than a single hardcoded SDK, so the same scoring and
          tailoring logic runs against Anthropic, OpenAI, NVIDIA NIM, or a
          local Ollama model. Fit scoring mixes model-judged categories
          (required skills, tech stack, experience level, preferred skills)
          with deterministic ones (seniority, location, remote preference,
          employment type, salary) — the model never sees the category
          weights, and application code, not the model, owns the safety
          rules and state transitions.
        </p>
      </div>
    </section>

    <!-- 7: Safety architecture -->
    <section class="border-t border-graphite-700/80 py-14">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-paper-500">
          Safety architecture
        </h2>
        <ul class="mt-6 space-y-3">
          {
            safety.map((item) => (
              <li class="flex gap-3 text-paper-300">
                <span class="mt-1 text-cyan-400">▸</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 8: Engineering evidence -->
    <section class="border-t border-graphite-700/80 py-14">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-paper-500">
          Engineering evidence
        </h2>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            engineering.map((t) => (
              <span
                class="font-mono-tight rounded-md border border-graphite-700 px-3 py-1.5 text-xs text-paper-200"
              >
                {t}
              </span>
            ))
          }
        </div>
        <p class="mt-5 text-sm text-paper-500">
          290+ test files across backend, desktop, and Electron E2E as of
          August 2026. Cross-platform packaging targets Windows, macOS, and
          Linux.
        </p>
      </div>
    </section>

    <!-- 9: Lessons learned -->
    <section class="border-t border-graphite-700/80 py-14">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-paper-500">
          Lessons learned
        </h2>
        <ul class="mt-6 space-y-4">
          {
            lessons.map((l) => (
              <li class="border-l-2 border-graphite-600 pl-4 text-paper-300">
                {l}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 10: Final CTA -->
    <section class="border-t border-graphite-700/80 py-16">
      <div class="mx-auto max-w-4xl px-6 text-center">
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="https://github.com/pushpendra-devera/ai-job-agent"
            class="rounded-md bg-cyan-500 px-5 py-2.5 text-sm font-medium text-graphite-950 transition-colors hover:bg-cyan-400"
          >
            View GitHub
          </a>
          <a
            href="/architecture"
            class="rounded-md border border-graphite-600 px-5 py-2.5 text-sm font-medium text-paper-100 transition-colors hover:border-cyan-500 hover:text-cyan-400"
          >
            Read architecture
          </a>
          <a
            href="/contact"
            class="rounded-md border border-graphite-600 px-5 py-2.5 text-sm font-medium text-paper-100 transition-colors hover:border-cyan-500 hover:text-cyan-400"
          >
            Contact me
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
