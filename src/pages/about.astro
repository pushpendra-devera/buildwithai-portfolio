---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
import { isPublicLink } from "../lib/links";

const sameAs = [siteConfig.githubUrl, siteConfig.linkedinUrl].filter(
  isPublicLink,
);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.author,
  url: "https://buildwithai.in/about",
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<BaseLayout
  title="About"
  description="Pushpendra Singh builds practical, human-supervised AI products for real workflows."
  structuredData={personSchema}
>
  <main id="main-content" class="bg-grid">
    <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
      <h1 class="text-3xl font-semibold tracking-tight text-paper-50">
        About
      </h1>
      <p class="mt-6 text-lg text-paper-300">
        I'm Pushpendra Singh. Build With AI is where I ship AI-assisted
        software that stays honest about what it can and can't do — systems
        that keep a human at the one step that actually matters, instead of
        automating everything just because it's possible.
      </p>
      <p class="mt-4 text-paper-300">
        My flagship project, <a
          href="/projects/ai-job-agent"
          class="text-cyan-400 underline underline-offset-2"
        >AI Job Agent</a>, grew out of a personal problem: job searching is
        fragmented, repetitive, and easy to automate badly. The interesting
        engineering problem wasn't "can a bot apply to jobs" — it was how to
        build something genuinely useful without ever letting it submit
        anything on my behalf.
      </p>
    </section>
  </main>
</BaseLayout>
