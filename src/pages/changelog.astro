---
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = [
  {
    date: "2026-08-22",
    items: [
      "Outreach credit optimizer — a warm-first, cold-fallback contact queue for referral outreach",
      "Subscription ROI dashboard — spend and usage correlated against outcomes",
      "Recognized LinkedIn/Naukri job-alert email link formats for import",
      "Premium signal capture and priority ranking from LinkedIn/Naukri alerts",
      "Alert Fast Lane — ATS link recognition surfaced directly from inbox alerts",
    ],
  },
  {
    date: "2026-08-21",
    items: [
      "ATS-safe resume renderer",
      "Workday discovery and session handling",
      "Referral and outreach tracking",
      "Recruiter-reply detection",
      "Calendar export for interviews",
      "Email-alert ingestion (connection, scheduling, and settings UI)",
      "Today action queue — a single ranked daily worklist",
    ],
  },
  {
    date: "2026-08-20",
    items: [
      "Daily Opportunity Engine — unattended morning scan across configured boards, with a bounded timeout and no model spend on the scan itself",
    ],
  },
  {
    date: "2026-08-13",
    items: [
      "Naukri assisted handoff and outcome recording",
    ],
  },
  {
    date: "2026-08-12",
    items: [
      "Naukri assisted apply",
      "Generic company-site adapter for postings outside the six named ATS platforms",
    ],
  },
  {
    date: "2026-08-08",
    items: [
      "Jobvite screening and form filling",
      "Shadow-DOM-aware discovery",
    ],
  },
  {
    date: "2026-08-04",
    items: ["First desktop application shell — window, IPC bridge, settings and onboarding"],
  },
];
---

<BaseLayout
  title="Changelog"
  description="Dated development history for AI Job Agent, drawn from the project's own commit history."
>
  <main class="bg-grid">
    <section class="mx-auto max-w-3xl px-6 pb-6 pt-16 sm:pt-20">
      <p class="font-mono-tight text-xs text-cyan-400">Development history</p>
      <h1
        class="mt-3 text-3xl font-semibold tracking-tight text-paper-50 sm:text-4xl"
      >
        Changelog
      </h1>
      <p class="mt-5 text-paper-300">
        A dated selection of what shipped, pulled from the project's own git
        history rather than reconstructed from memory. It skips routine
        fixes, formatting, and flaky-test repairs — those are real work too,
        just not the story this page is telling.
      </p>
    </section>

    <section class="border-t border-graphite-700/80 py-12">
      <div class="mx-auto max-w-3xl px-6">
        <ol class="space-y-10">
          {
            entries.map((entry) => (
              <li>
                <p class="font-mono-tight text-sm text-cyan-400">{entry.date}</p>
                <ul class="mt-3 space-y-2 border-l-2 border-graphite-700 pl-4">
                  {entry.items.map((item) => (
                    <li class="text-paper-300">{item}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>
