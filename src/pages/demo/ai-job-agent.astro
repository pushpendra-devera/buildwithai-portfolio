---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Interactive Demo"
  description="A synthetic walkthrough of AI Job Agent — fictional job, fit score, tailored resume, and review queue. No real accounts or applications involved."
>
  <main class="bg-grid">
    <section class="mx-auto max-w-3xl px-6 pb-6 pt-16 sm:pt-20">
      <p class="font-mono-tight text-xs text-cyan-400">Interactive demo</p>
      <h1
        class="mt-3 text-3xl font-semibold tracking-tight text-paper-50 sm:text-4xl"
      >
        Walk through AI Job Agent
      </h1>
      <div
        class="mt-6 rounded-md border border-amber-500/40 bg-amber-500/5 px-4 py-3 text-sm text-amber-400"
      >
        Demonstration mode — uses synthetic data and performs no real
        applications or external account access. Nothing here touches a real
        job board, ATS, or resume.
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-6 py-4">
      <div
        id="pipeline"
        class="flex flex-wrap items-center gap-2 text-xs"
        aria-hidden="true"
      >
      </div>
      <p id="step-status" class="mt-3 text-sm text-paper-500" aria-live="polite">
      </p>
    </section>

    <section id="demo-root" class="mx-auto max-w-3xl px-6 pb-24"></section>
  </main>
</BaseLayout>

<script>
  type Category = { label: string; score: number; kind: "model" | "rule" };
  type Job = {
    id: string;
    title: string;
    company: string;
    location: string;
    type: string;
    description: string;
    categories: Category[];
    missingSkills: string[];
    tailoredSummary: { before: string; after: string };
    resumeHighlights: string[];
    outcome: { days: number; message: string; positive: boolean };
  };

  const JOBS: Job[] = [
    {
      id: "backend",
      title: "Senior Backend Engineer",
      company: "NimbusStack (fictional)",
      location: "Remote",
      type: "Full-time",
      description:
        "Own service reliability for a Node.js/Postgres platform handling checkout and payments.",
      categories: [
        { label: "Required skills", score: 88, kind: "model" },
        { label: "Tech stack", score: 82, kind: "model" },
        { label: "Experience level", score: 90, kind: "model" },
        { label: "Preferred skills", score: 60, kind: "model" },
        { label: "Seniority", score: 100, kind: "rule" },
        { label: "Location", score: 100, kind: "rule" },
        { label: "Remote preference", score: 100, kind: "rule" },
        { label: "Employment type", score: 100, kind: "rule" },
        { label: "Salary", score: 75, kind: "rule" },
      ],
      missingSkills: ["Kubernetes", "gRPC"],
      tailoredSummary: {
        before:
          "Backend engineer with experience building APIs and working with databases.",
        after:
          "Backend engineer who has shipped and operated payment-critical Node.js/Postgres services at scale, with a focus on reliability and incident response.",
      },
      resumeHighlights: [
        "Reordered \"Distributed systems\" above \"Frontend tooling\" to match the posting's emphasis",
        "Reused an existing bullet about on-call incident response verbatim — nothing invented",
        "Trimmed unrelated frontend bullets rather than padding with new claims",
      ],
      outcome: {
        days: 6,
        message:
          "Thanks for applying — we'd like to schedule a first-round call. Are you free Thursday?",
        positive: true,
      },
    },
    {
      id: "analyst",
      title: "Product Analyst",
      company: "Northwind Analytics (fictional)",
      location: "Bengaluru, India",
      type: "Full-time",
      description:
        "Turn product usage data into decisions for a B2B SaaS analytics team.",
      categories: [
        { label: "Required skills", score: 70, kind: "model" },
        { label: "Tech stack", score: 55, kind: "model" },
        { label: "Experience level", score: 65, kind: "model" },
        { label: "Preferred skills", score: 40, kind: "model" },
        { label: "Seniority", score: 100, kind: "rule" },
        { label: "Location", score: 100, kind: "rule" },
        { label: "Remote preference", score: 50, kind: "rule" },
        { label: "Employment type", score: 100, kind: "rule" },
        { label: "Salary", score: 60, kind: "rule" },
      ],
      missingSkills: ["dbt", "Looker", "A/B testing statistics"],
      tailoredSummary: {
        before: "Engineer interested in data and analytics.",
        after:
          "Engineer with hands-on SQL and product-metrics experience, looking to move into a dedicated analyst role.",
      },
      resumeHighlights: [
        "Surfaced a SQL/reporting side-project higher in the experience section",
        "Did not add dbt or Looker — the applicant has never used them",
        "Flagged three missing preferred skills instead of concealing the gap",
      ],
      outcome: {
        days: 9,
        message:
          "We've decided to move forward with other candidates whose analytics tooling experience is a closer match.",
        positive: false,
      },
    },
    {
      id: "platform",
      title: "Platform Engineer",
      company: "Aurora Cloudworks (fictional)",
      location: "Remote",
      type: "Contract",
      description:
        "Build internal developer platform tooling on top of Kubernetes and Terraform.",
      categories: [
        { label: "Required skills", score: 92, kind: "model" },
        { label: "Tech stack", score: 95, kind: "model" },
        { label: "Experience level", score: 85, kind: "model" },
        { label: "Preferred skills", score: 80, kind: "model" },
        { label: "Seniority", score: 100, kind: "rule" },
        { label: "Location", score: 100, kind: "rule" },
        { label: "Remote preference", score: 100, kind: "rule" },
        { label: "Employment type", score: 40, kind: "rule" },
        { label: "Salary", score: 85, kind: "rule" },
      ],
      missingSkills: ["Pulumi"],
      tailoredSummary: {
        before: "DevOps-minded engineer who enjoys automation.",
        after:
          "Platform engineer who has built and maintained internal Kubernetes/Terraform tooling used by other engineering teams daily.",
      },
      resumeHighlights: [
        "Reworded summary around \"internal developer platform\" language from the posting",
        "Contract employment type scored low on fit — surfaced, not hidden",
        "Reordered Terraform module work above unrelated mobile experience",
      ],
      outcome: {
        days: 4,
        message:
          "Your background is strong, but we're pausing this contract role for now. We'll keep your details on file.",
        positive: false,
      },
    },
  ];

  const PIPELINE_STEPS = [
    "Discover",
    "Rank",
    "Analyse",
    "Tailor",
    "Human review",
    "Assisted apply",
    "Follow up",
    "Learn",
  ] as const;

  let currentStep = 0;
  let selectedJob: Job | null = null;

  const pipelineEl = document.getElementById("pipeline")!;
  const statusEl = document.getElementById("step-status")!;
  const root = document.getElementById("demo-root")!;

  function renderPipeline() {
    pipelineEl.innerHTML = PIPELINE_STEPS.map((step, i) => {
      const active = i === currentStep;
      const isHumanReview = step === "Human review";
      const base =
        "font-mono-tight rounded-md border px-3 py-1.5 whitespace-nowrap";
      const color = active
        ? isHumanReview
          ? "border-amber-500 text-amber-400 bg-amber-500/10"
          : "border-cyan-500 text-cyan-400 bg-cyan-500/10"
        : isHumanReview
          ? "border-graphite-600 text-amber-500/70"
          : "border-graphite-700 text-paper-500";
      return `<span class="${base} ${color}">${step}</span>`;
    }).join('<span class="text-paper-600">&rarr;</span>');
  }

  function setStatus(text: string) {
    statusEl.textContent = text;
  }

  function scoreColor(score: number) {
    if (score >= 80) return "text-cyan-400";
    if (score >= 55) return "text-amber-400";
    return "text-paper-400";
  }

  function overallScore(job: Job) {
    const total = job.categories.reduce((sum, c) => sum + c.score, 0);
    return Math.round(total / job.categories.length);
  }

  function renderJobList() {
    currentStep = 0;
    selectedJob = null;
    renderPipeline();
    setStatus("Step 1 of 4 — pick a fictional posting to run through the pipeline.");
    root.innerHTML = `
      <div class="grid gap-3">
        ${JOBS.map(
          (job) => `
          <button
            data-job="${job.id}"
            class="job-card w-full rounded-lg border border-graphite-700 p-4 text-left transition-colors hover:border-cyan-500"
          >
            <div class="flex items-center justify-between">
              <span class="font-medium text-paper-50">${job.title}</span>
              <span class="font-mono-tight text-sm ${scoreColor(overallScore(job))}">${overallScore(job)}% fit</span>
            </div>
            <p class="mt-1 text-sm text-paper-400">${job.company} · ${job.location} · ${job.type}</p>
            <p class="mt-2 text-sm text-paper-500">${job.description}</p>
          </button>`,
        ).join("")}
      </div>
    `;
    root.querySelectorAll<HTMLButtonElement>(".job-card").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedJob = JOBS.find((j) => j.id === btn.dataset.job) ?? null;
        if (selectedJob) renderScore(selectedJob);
      });
    });
  }

  function renderScore(job: Job) {
    currentStep = 2;
    renderPipeline();
    setStatus("Step 2 of 4 — fit score breakdown (precomputed for this demo, not a live model call).");
    root.innerHTML = `
      <div class="rounded-lg border border-graphite-700 p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-medium text-paper-50">${job.title} — ${job.company}</h2>
          <span class="font-mono-tight text-lg ${scoreColor(overallScore(job))}">${overallScore(job)}%</span>
        </div>
        <div class="mt-5 space-y-3">
          ${job.categories
            .map(
              (c) => `
            <div>
              <div class="flex justify-between text-xs text-paper-400">
                <span>${c.label} <span class="text-paper-600">(${c.kind === "model" ? "model-judged" : "deterministic"})</span></span>
                <span>${c.score}%</span>
              </div>
              <div class="mt-1 h-1.5 w-full rounded-full bg-graphite-800">
                <div class="h-1.5 rounded-full bg-cyan-500" style="width:${c.score}%"></div>
              </div>
            </div>`,
            )
            .join("")}
        </div>
        <div class="mt-6 rounded-md border border-graphite-700 bg-graphite-900 p-3">
          <p class="text-xs font-medium uppercase tracking-wide text-paper-500">Missing skills flagged, not hidden</p>
          <p class="mt-1 text-sm text-paper-300">${job.missingSkills.join(", ")}</p>
        </div>
        <div class="mt-6 flex gap-3">
          <button id="back-to-jobs" class="rounded-md border border-graphite-600 px-4 py-2 text-sm text-paper-100 hover:border-cyan-500 hover:text-cyan-400">Back</button>
          <button id="to-tailor" class="rounded-md bg-cyan-500 px-4 py-2 text-sm font-medium text-graphite-950 hover:bg-cyan-400">Continue to tailoring</button>
        </div>
      </div>
    `;
    document.getElementById("back-to-jobs")!.addEventListener("click", renderJobList);
    document.getElementById("to-tailor")!.addEventListener("click", () => renderTailor(job));
  }

  function renderTailor(job: Job) {
    currentStep = 3;
    renderPipeline();
    setStatus("Step 3 of 4 — tailored summary and resume preview, then a human decision.");
    root.innerHTML = `
      <div class="space-y-5">
        <div class="rounded-lg border border-graphite-700 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-paper-500">Tailored summary</h3>
          <p class="mt-3 text-sm text-paper-500 line-through decoration-graphite-600">${job.tailoredSummary.before}</p>
          <p class="mt-2 text-sm text-paper-100">${job.tailoredSummary.after}</p>
        </div>
        <div class="rounded-lg border border-graphite-700 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-paper-500">ATS-safe resume — what changed</h3>
          <ul class="mt-3 space-y-2">
            ${job.resumeHighlights.map((h) => `<li class="flex gap-2 text-sm text-paper-300"><span class="text-cyan-400">&#9656;</span><span>${h}</span></li>`).join("")}
          </ul>
        </div>
        <div class="rounded-lg border border-amber-500/40 bg-amber-500/5 p-5">
          <h3 class="text-sm font-semibold text-amber-400">Human review gate</h3>
          <p class="mt-2 text-sm text-paper-300">The run pauses here. Nothing is sent anywhere until you approve it.</p>
          <div class="mt-4 flex gap-3">
            <button id="decline" class="rounded-md border border-graphite-600 px-4 py-2 text-sm text-paper-100 hover:border-graphite-400">Decline</button>
            <button id="approve" class="rounded-md bg-amber-500 px-4 py-2 text-sm font-medium text-graphite-950 hover:bg-amber-400">Approve</button>
          </div>
        </div>
      </div>
    `;
    document.getElementById("decline")!.addEventListener("click", () => renderDeclined(job));
    document.getElementById("approve")!.addEventListener("click", () => renderHandoff(job));
  }

  function renderDeclined(job: Job) {
    root.innerHTML = `
      <div class="rounded-lg border border-graphite-700 p-6 text-center">
        <p class="text-paper-100">Declined. No application was prepared for ${job.title}.</p>
        <button id="restart" class="mt-4 rounded-md border border-graphite-600 px-4 py-2 text-sm text-paper-100 hover:border-cyan-500 hover:text-cyan-400">Try another job</button>
      </div>
    `;
    document.getElementById("restart")!.addEventListener("click", renderJobList);
  }

  function renderHandoff(job: Job) {
    currentStep = 5;
    renderPipeline();
    setStatus("Step 4 of 4 — assisted apply. A browser opens, fills what it can verify, and stops for you.");
    const fields = [
      "Name",
      "Email",
      "Resume file",
      `"Why this role?" — left blank, drafted by you`,
    ];
    root.innerHTML = `
      <div class="rounded-lg border border-graphite-700 p-5">
        <div class="rounded-md border border-graphite-600 bg-graphite-900 p-4 font-mono-tight text-xs text-paper-500">
          fictional-ats.example.com/apply
        </div>
        <ul id="fill-list" class="mt-4 space-y-2">
          ${fields.map((f) => `<li class="fill-row flex items-center gap-2 text-sm text-paper-500" data-pending="true"><span class="dot h-1.5 w-1.5 rounded-full bg-graphite-600"></span><span>${f}</span></li>`).join("")}
        </ul>
        <p id="handoff-status" class="mt-4 text-sm text-paper-400">Filling verifiable fields…</p>
        <div id="confirm-area" class="mt-4 hidden">
          <p class="text-sm text-paper-300">The browser stays open. Submitting is up to you — this demo never clicks Submit.</p>
          <button id="confirm-submitted" class="mt-3 rounded-md bg-cyan-500 px-4 py-2 text-sm font-medium text-graphite-950 hover:bg-cyan-400">I confirm I submitted this, in real life</button>
        </div>
      </div>
    `;
    const rows = Array.from(root.querySelectorAll<HTMLLIElement>(".fill-row"));
    rows.forEach((row, i) => {
      setTimeout(() => {
        row.querySelector(".dot")?.classList.remove("bg-graphite-600");
        row.querySelector(".dot")?.classList.add("bg-cyan-500");
        row.classList.remove("text-paper-500");
        row.classList.add("text-paper-100");
        if (i === rows.length - 1) {
          const statusLine = document.getElementById("handoff-status");
          if (statusLine) statusLine.textContent = "Fields verified. Waiting for you — nothing has been submitted.";
          document.getElementById("confirm-area")?.classList.remove("hidden");
        }
      }, (i + 1) * 500);
    });
    document.getElementById("confirm-submitted")?.addEventListener("click", () => renderFollowUp(job));
  }

  function renderFollowUp(job: Job) {
    currentStep = 6;
    renderPipeline();
    setStatus("Follow up — waiting for a response.");
    root.innerHTML = `
      <div class="rounded-lg border border-graphite-700 p-6 text-center">
        <p class="text-paper-100">Application recorded as submitted.</p>
        <button id="simulate-time" class="mt-4 rounded-md border border-graphite-600 px-4 py-2 text-sm text-paper-100 hover:border-cyan-500 hover:text-cyan-400">Simulate ${job.outcome.days} days passing</button>
      </div>
    `;
    document.getElementById("simulate-time")!.addEventListener("click", () => renderOutcome(job));
  }

  function renderOutcome(job: Job) {
    currentStep = 7;
    renderPipeline();
    setStatus("Learn — this fictional outcome feeds the analytics view.");
    const before = { sent: 12, responses: 4 };
    const after = {
      sent: before.sent + 1,
      responses: before.responses + (job.outcome.positive ? 1 : 0),
    };
    root.innerHTML = `
      <div class="space-y-5">
        <div class="rounded-lg border ${job.outcome.positive ? "border-cyan-500/40 bg-cyan-500/5" : "border-graphite-700"} p-5">
          <p class="font-mono-tight text-xs text-paper-500">Fictional recruiter reply — ${job.company}</p>
          <p class="mt-2 text-paper-100">"${job.outcome.message}"</p>
        </div>
        <div class="rounded-lg border border-graphite-700 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-paper-500">Analytics (fictional month-to-date)</h3>
          <div class="mt-4 grid grid-cols-3 gap-4 text-center">
            <div>
              <p class="font-mono-tight text-2xl text-paper-50">${after.sent}</p>
              <p class="text-xs text-paper-500">Applications sent</p>
            </div>
            <div>
              <p class="font-mono-tight text-2xl text-paper-50">${after.responses}</p>
              <p class="text-xs text-paper-500">Responses</p>
            </div>
            <div>
              <p class="font-mono-tight text-2xl text-cyan-400">${Math.round((after.responses / after.sent) * 100)}%</p>
              <p class="text-xs text-paper-500">Response rate</p>
            </div>
          </div>
        </div>
        <div class="text-center">
          <button id="restart" class="rounded-md border border-graphite-600 px-4 py-2 text-sm text-paper-100 hover:border-cyan-500 hover:text-cyan-400">Try another job</button>
        </div>
      </div>
    `;
    document.getElementById("restart")!.addEventListener("click", renderJobList);
  }

  renderJobList();
</script>
