---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist on Build With AI."
  noindex
>
  <main id="main-content" class="bg-grid">
    <section class="mx-auto max-w-2xl px-6 py-24 text-center sm:py-32">
      <p class="font-mono-tight text-sm text-cyan-400">404</p>
      <h1
        class="mt-3 text-3xl font-semibold tracking-tight text-paper-50 sm:text-4xl"
      >
        This page doesn't exist.
      </h1>
      <p class="mt-5 text-paper-300">
        The link may be old, mistyped, or the page may have moved.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="rounded-md bg-cyan-500 px-5 py-2.5 text-sm font-medium text-graphite-950 transition-colors hover:bg-cyan-400"
        >
          Go home
        </a>
        <a
          href="/projects/ai-job-agent"
          class="rounded-md border border-graphite-600 px-5 py-2.5 text-sm font-medium text-paper-100 transition-colors hover:border-cyan-500 hover:text-cyan-400"
        >
          Read the case study
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
