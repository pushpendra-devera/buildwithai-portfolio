---
import { siteConfig } from "../config";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => currentPath === href.replace(/\/$/, "");
---

<header class="relative border-b border-graphite-700/80">
  <div
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5"
  >
    <a
      href="/"
      class="font-mono-tight text-sm font-semibold tracking-tight text-paper-50"
    >
      build<span class="text-cyan-400">with</span>ai<span
        class="text-paper-500">.in</span
      >
    </a>
    <nav aria-label="Primary" class="hidden gap-6 text-sm text-paper-300 sm:flex">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-cyan-400",
              isActive(item.href) && "text-cyan-400",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="flex h-9 w-9 items-center justify-center rounded-md border border-graphite-600 text-paper-100 sm:hidden"
    >
      <svg
        id="nav-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg
        id="nav-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        class="hidden h-5 w-5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <nav
    id="mobile-nav"
    aria-label="Primary, mobile"
    class="hidden flex-col gap-1 border-t border-graphite-700/80 px-6 py-3 text-sm text-paper-300 sm:hidden"
  >
    {
      siteConfig.nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-md px-2 py-2.5 transition-colors hover:bg-graphite-800 hover:text-cyan-400",
            isActive(item.href) && "text-cyan-400",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-nav");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  function isMenuOpen() {
    return !menu?.classList.contains("hidden");
  }

  function openMenu() {
    menu?.classList.remove("hidden");
    menu?.classList.add("flex");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
  }

  function closeMenu({ returnFocus = false } = {}) {
    menu?.classList.add("hidden");
    menu?.classList.remove("flex");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    if (returnFocus) toggle?.focus();
  }

  toggle?.addEventListener("click", () => {
    if (isMenuOpen()) closeMenu();
    else openMenu();
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isMenuOpen()) {
      closeMenu({ returnFocus: true });
    }
  });
</script>
